# ==============================================================================
# TCT FULL MULTI-TENANT CONFIGURATION FILE (tctfile)
# YAML Format | Supports up to 5 Bot Sessions
# ==============================================================================

# ------------------------------------------------------------------------------
# GLOBAL INSTANCE SETTINGS
# These apply to the entire application / all bots running on this server.
# ------------------------------------------------------------------------------

# --- Server & Deployment ---
SERVER_PORT: 3003

# --- Global Logging (Applies to all bots) ---
FILTER_NOISE_LOGS: true
LOG_TO_FILE: true
LOG_FILE_PATH: "data/app.log"
LOG_LEVEL: "info"

# ------------------------------------------------------------------------------
# DATABASE SETTINGS 
# ------------------------------------------------------------------------------
DATABASE:
  SYNC_MODE: "NORMAL"
  BATCH_SIZE: 200
  FLUSH_INTERVAL: "5000"
  CACHE_MAX_BYTES: 134217728
  USE_WAL: true
  BUSY_TIMEOUT_MS: 15000

POSTGRES_SYNC_INTERVAL: 60

# ==============================================================================
# DEFAULT TEMPLATES (YAML Anchors)
# ==============================================================================

